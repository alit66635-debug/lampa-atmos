(function () {
    'use strict';

    function getDescription(e) {
        var out = [];

        function walk(v, d) {
            if (d > 3 || v == null) return;

            if (typeof v === 'string') {
                out.push(v);
                return;
            }

            if (Array.isArray(v)) {
                v.forEach(function (x) {
                    walk(x, d + 1);
                });
                return;
            }

            if (typeof v === 'object') {
                [
                    'Description',
                    'description',
                    'Desc',
                    'desc',
                    'Comment',
                    'comment'
                ].forEach(function (k) {
                    if (v[k] != null) walk(v[k], d + 1);
                });
            }
        }

        walk(e, 0);
        return out.join(' | ');
    }

    function isEac3Atmos(e) {
        var s = getDescription(e)
            .replace(/<[^>]+>/g, ' ')
            .toLowerCase();

        return (
            /atmos|\bjoc\b/.test(s) &&
            /e-?ac-?3|eac3|ddp|dd\+|dolby\s+digital\s+plus/.test(s)
        );
    }

    function add(e, item) {
        try {
            if (!isEac3Atmos(e)) return;
            if (item.find('.mi-eac3-atmos-fix').length) return;

            item.append(
                '<div class="mi-eac3-atmos-fix">' +
                '<span>♪ Atmos</span>' +
                '</div>'
            );
        } catch (x) {}
    }

    function start() {
        if (document.getElementById('mi-eac3-atmos-fix-style')) return;

        var st = document.createElement('style');
        st.id = 'mi-eac3-atmos-fix-style';
        st.textContent =
            '.mi-eac3-atmos-fix{' +
                'display:flex;' +
                'margin-top:.4em;' +
                'font-size:.78em;' +
                'opacity:.95' +
            '}' +
            '.mi-eac3-atmos-fix span{' +
                'border:1px solid rgba(124,252,0,.5);' +
                'border-radius:.3em;' +
                'padding:.05em .45em;' +
                'background:rgba(124,252,0,.13)' +
            '}';

        document.head.appendChild(st);

        Lampa.Listener.follow('torrent', function (data) {
            if (
                data &&
                data.type === 'render' &&
                data.element &&
                data.item
            ) {
                add(data.element, data.item);
            }
        });
    }

    if (window.appready) {
        start();
    } else {
        Lampa.Listener.follow('app', function (e) {
            if (e.type === 'ready') start();
        });
    }
})();
